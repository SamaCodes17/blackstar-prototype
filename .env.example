# The public fictional demo needs no API key, database or account.
PORT=4173
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:4173
# Cloud: HOST=0.0.0.0, PUBLIC_ORIGIN=https://your-service.onrender.com
# Managed PostgreSQL for private assessments; use provider-required TLS externally.
DATABASE_URL=
# Unique 32+ character signing secret and salted scrypt password hash.
SESSION_SECRET=
ADMIN_PASSWORD_HASH=
# Exact domains verified out of band by an administrator.
ADMIN_APPROVED_DOMAINS=
ENABLE_LIVE_COLLECTION=false
# Only admin collection uses these; never exposed to viewers.
SHODAN_API_KEY=
NVD_API_KEY=
